VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry error monitoring (optional - leave empty to disable)
VITE_SENTRY_DSN=

# E2E Testing (optional - required for the authenticated Playwright tests)
# Create a dedicated test user in Supabase, then sign in once by hand and create
# its vault with the passphrase below. The fixture unlocks that vault; it will
# not create one. See docs/setup/e2e-testing-setup.md.
# These credentials should NEVER be committed - use .env.local (git-ignored)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_PASSPHRASE=
