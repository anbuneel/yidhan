{
  "name": "yidhan-app",
    "private": true,
    "version": "3.15.0",
    "type": "module",
  "reactDoctor": {
    "ignore": {
      "overrides": [
        {
          "files": [
            "src/**"
          ],
          "rules": [
            "deslop/unused-file"
          ]
        },
        {
          "files": [
            "package.json"
          ],
          "rules": [
            "deslop/unused-dependency"
          ]
        },
        {
          "files": [
            "src/components/NoteCard.tsx",
            "src/components/FadedNoteCard.tsx",
            "src/components/SharedNoteView.tsx"
          ],
          "rules": [
            "react-doctor/no-danger"
          ]
        },
        {
          "files": [
            "src/components/PassphraseSetup.tsx",
            "src/components/PassphraseUnlock.tsx"
          ],
          "rules": [
            "react-doctor/no-autofocus"
          ]
        },
        {
          "files": [
            "src/components/TagPill.tsx"
          ],
          "rules": [
            "react-doctor/no-large-animated-blur"
          ]
        },
        {
          "files": [
            "src/**"
          ],
          "rules": [
            "react-doctor/async-await-in-loop",
            "react-doctor/async-defer-await",
            "react-doctor/async-parallel",
            "react-doctor/exhaustive-deps",
            "react-doctor/js-combine-iterations",
            "react-doctor/js-index-maps",
            "react-doctor/js-tosorted-immutable",
            "react-doctor/jsx-no-jsx-as-prop",
            "react-doctor/no-cascading-set-state",
            "react-doctor/no-chain-state-updates",
            "react-doctor/no-derived-state",
            "react-doctor/no-derived-state-effect",
            "react-doctor/no-derived-useState",
            "react-doctor/no-effect-chain",
            "react-doctor/no-event-handler",
            "react-doctor/no-giant-component",
            "react-doctor/no-inline-exhaustive-style",
            "react-doctor/no-pass-data-to-parent",
            "react-doctor/no-prop-callback-in-effect",
            "react-doctor/no-reset-all-state-on-prop-change",
            "react-doctor/prefer-useReducer",
            "react-doctor/rerender-state-only-in-handlers",
            "react-doctor/server-sequential-independent-await"
          ]
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "theme:generate": "tsx scripts/generate-theme-css.ts",
    "theme:preview": "tsx scripts/generate-theme-css.ts --preview",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "og:generate": "tsx scripts/generate-og-image.ts",
    "splash:generate": "tsx scripts/generate-splash-screens.ts",
    "docs:sync-agents": "node scripts/sync-agents.mjs",
    "docs:sync-agents:check": "node scripts/sync-agents.mjs --check",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:android:run": "npm run build && npx cap sync android && npx cap run android",
    "doctor": "npx -y react-doctor@0.4.2 --no-telemetry"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@react-spring/web": "^10.0.3",
    "@sentry/react": "^10.30.0",
    "@supabase/supabase-js": "^2.86.2",
    "@tiptap/extension-highlight": "^3.13.0",
    "@tiptap/extension-placeholder": "^3.13.0",
    "@tiptap/extension-task-item": "^3.13.0",
    "@tiptap/extension-task-list": "^3.13.0",
    "@tiptap/extension-text-align": "^3.13.0",
    "@tiptap/extension-underline": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@tiptap/suggestion": "^3.13.0",
    "@use-gesture/react": "^10.3.1",
    "dexie": "^4.2.1",
    "dompurify": "^3.3.1",
    "hash-wasm": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-masonry-css": "^1.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.15"
  }
}
