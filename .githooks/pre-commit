#!/bin/sh
set -e

# AGENTS.md is generated from CLAUDE.md; refresh and stage it from the staged blob.
# Uses the staged blob (not the worktree) so partial staging cannot desync them.
if ! git diff --cached --quiet -- CLAUDE.md; then
  if git cat-file -e :CLAUDE.md 2>/dev/null; then
    git show :CLAUDE.md > AGENTS.md
    git add AGENTS.md
  fi
fi

# A bounded number of ACTIVE plans, each carrying a 'Last verified' date.
# One ACTIVE plan, so "what are we working on now" has one answer. It was 2 while
# the documentation overhaul ran alongside the product ledger; that plan is now
# COMPLETE (DECISIONS.md, 2026-09-08). Raising this needs a DECISIONS.md entry.
MAX_ACTIVE_PLANS=1

actives=$(git grep --cached -l -e '^Status: ACTIVE$' -- ':(glob)docs/plans/*.md' 2>/dev/null || true)
count=0
for f in $actives; do count=$((count + 1)); done
if [ "$count" -gt "$MAX_ACTIVE_PLANS" ]; then
  echo "pre-commit: $count plans staged with 'Status: ACTIVE' (max $MAX_ACTIVE_PLANS):" >&2
  printf '%s\n' "$actives" >&2
  echo "pre-commit: close one, or record the exception in DECISIONS.md and raise MAX_ACTIVE_PLANS." >&2
  exit 1
fi
for f in $actives; do
  if ! git grep --cached -q -E -e '^Last verified: [0-9]{4}-[0-9]{2}-[0-9]{2}$' -- "$f"; then
    echo "pre-commit: ACTIVE plan lacks 'Last verified: YYYY-MM-DD': $f" >&2
    exit 1
  fi
done
